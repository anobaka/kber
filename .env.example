# ===== Feishu =====
FEISHU_APP_ID=your_feishu_app_id
FEISHU_APP_SECRET=your_feishu_app_secret

# ===== MySQL =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=kber

# ===== Milvus =====
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530

# ===== LLM (Alibaba Cloud Bailian / OpenAI-compatible) =====
LLM_API_KEY=your_api_key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=minimax-m2.5
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2

# ===== Embedding =====
EMBEDDING_API_KEY=your_embedding_api_key
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

# ===== Git / Code Repos =====
# GitLab base URL (users only need to provide org/repo when binding)
GIT_BASE_URL=https://gitlab.mycompany.com
GIT_PAT=your_gitlab_personal_access_token
REPOS_BASE_DIR=/data/repos

# ===== Redis (optional, for distributed locks) =====
REDIS_URL=redis://127.0.0.1:6379/0

# ===== Knowledge Limits =====
KB_SOFT_LIMIT=10000
KB_HARD_LIMIT=15000
KNOWLEDGE_COLD_DAYS=90
SIMILARITY_MERGE_THRESHOLD=0.92

# ===== Scheduler =====
SUMMARIZE_INTERVAL_MINUTES=5
HISTORY_COMPENSATE_INTERVAL_MINUTES=30
CODE_UPDATE_INTERVAL_MINUTES=30
